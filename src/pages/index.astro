---
import HomeNav from "@/components/home/HomeNav.astro";
import Opening from "@/components/home/Opening.astro";
import Writing from "@/components/home/Writing.astro";
import {
	galleryConfig,
	musicPlayerConfig,
	navBarConfig,
	profileConfig,
} from "@/config";
import { scanAlbumPhotos, getAlbumCover } from "@/utils/gallery-utils";
import { getSortedPosts } from "@/utils/content-utils";
const albums = galleryConfig.albums
	.filter((album) => ["blog-art", "workbench"].includes(album.id))
	.map((album) => {
		const photos = scanAlbumPhotos(album.id);
		const preferred =
			album.id === "blog-art" ? "coronation.webp" : "3D_PCB_2026-01-18.png";
		return {
			...album,
			cover:
				photos.find((p) => p.endsWith(preferred)) ||
				getAlbumCover(album, photos),
			count: photos.length,
		};
	});
const nav = navBarConfig.links.flatMap((link) => [
	link,
	...(link.children || []),
]);
const explore = ["/projects/", "/booknav/", "/archive/"]
	.map((path) => nav.find((link) => link.url === path))
	.filter((link) => !!link);
const posts = (await getSortedPosts()).filter((p) => !p.data.draft);
const tags = new Set(posts.flatMap((p) => p.data.tags));
const song = musicPlayerConfig.local?.playlist?.[0];
const playlist =
	musicPlayerConfig.mode === "meting" &&
	musicPlayerConfig.meting?.server === "netease" &&
	musicPlayerConfig.meting.type === "playlist"
		? "https://music.163.com/playlist?id=" +
			encodeURIComponent(musicPlayerConfig.meting.id || "")
		: "";
const canonical = new URL("/", Astro.site || Astro.url);
const subtitle = "工作手记、电子制作与个人项目";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" /><meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>
		<title>{profileConfig.name} 的博客</title><meta
			name="description"
			content={subtitle}
		/><link rel="canonical" href={canonical} />
		<meta property="og:title" content={profileConfig.name + " 的博客"} /><meta
			property="og:description"
			content={subtitle}
		/><meta property="og:type" content="website" /><meta
			property="og:url"
			content={canonical}
		/><meta
			property="og:image"
			content={new URL("/gallery/blog-art/balcony.webp", canonical)}
		/>
		<link rel="icon" href="/favicon/huazai666.png" /><link
			rel="alternate"
			type="application/rss+xml"
			title="RSS"
			href="/rss.xml"
		/>
	</head>
	<body data-no-swup>
		<a class="skip" href="#articles">跳至文章</a><main>
			<HomeNav />
			<Opening /><Writing entries={posts} />
			<section class="explore" aria-labelledby="explore-title">
				<h2 id="explore-title">继续探索</h2><div class="albums">
					{
						albums.map((a) => (
							<a href={"/gallery/" + a.id + "/"} class:list={["album", a.id]}>
								{a.cover && <img src={a.cover} alt="" loading="lazy" />}
								<div>
									<>
										<h3>{a.name}</h3>
										<span>{a.count} 张 · 进入相册 ↗</span>
									</>
								</div>
							</a>
						))
					}
				</div>
				<nav class="explore-nav" aria-label="继续探索">
					{
						explore.map((l) => (
							<a href={l.url}>
								{l.url === "/archive/" ? "文章归档" : l.name} ↗
							</a>
						))
					}
				</nav>
			</section>
		</main><footer>
			<a href="#opening">{profileConfig.name} ↑</a><details>
				<summary>站点工具</summary><div class="tools">
					<a href="/archive/">公开文章 {posts.length} 篇</a><a href="/tags/">
						标签 {tags.size} 个
					</a><a href="/rss/">RSS 订阅</a>{
						playlist && <a href={playlist}>音乐歌单 ↗</a>
					}{
						song && (
							<label>
								{song.name}
								<audio
									controls
									preload="none"
									src={song.url}
									aria-label={song.name}
								/>
							</label>
						)
					}
				</div>
			</details>
		</footer>
	</body>
</html>
<style is:global>
	:root {
		--edge: clamp(20px, 4.3vw, 88px);
		--gold: #e3c180;
		color-scheme: light;
		font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
	}
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		background: #1d1e1b;
	}
	body {
		color: #f5f1e7;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	button,
	summary,
	a {
		touch-action: manipulation;
	}
	a:focus-visible,
	button:focus-visible,
	summary:focus-visible {
		outline: 3px solid #a47d3f;
		outline-offset: 3px;
	}
	time {
		font-family: ui-monospace, Menlo, monospace;
		font-variant-numeric: tabular-nums;
	}
	.skip {
		position: absolute;
		z-index: 10;
		left: 16px;
		top: 6px;
		padding: 9px 15px;
		background: #25241f;
		transform: translateY(-150%);
	}
	.skip:focus {
		transform: none;
	}
	img {
		display: block;
	}
	.explore {
		padding: clamp(42px, 5vw, 90px) var(--edge) 32px;
	}
	.explore h2 {
		font-size: clamp(36px, 4.5vw, 78px);
		line-height: 1.1;
		letter-spacing: -0.045em;
		font-weight: 650;
		margin: 0 0 30px;
	}
	.albums {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(16px, 2vw, 42px);
	}
	.album img {
		width: 100%;
		height: auto;
		aspect-ratio: 2;
		object-fit: cover;
	}
	.album.workbench img {
		object-fit: contain;
		background: #dce0d5;
	}
	.album div,
	.explore-nav,
	footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.album div {
		gap: 12px;
		padding: 15px 0;
	}
	.album h3 {
		font-size: clamp(22px, 2vw, 36px);
		margin: 0;
		font-weight: 600;
	}
	.album span {
		color: #d5cbb8;
		font-size: 13px;
	}
	.explore-nav {
		justify-content: flex-start;
		gap: 30px;
		flex-wrap: wrap;
		border-top: 1px solid #57564b;
		margin-top: 20px;
		padding-top: 22px;
	}
	.explore a:hover,
	footer a:hover {
		color: var(--gold);
	}
	footer {
		margin: 0 var(--edge);
		align-items: baseline;
		border-top: 1px solid #57564b;
		padding: 22px 0 30px;
		color: #d5cbb8;
		font-size: 14px;
	}
	footer summary {
		text-align: right;
		cursor: pointer;
	}
	.tools {
		display: grid;
		justify-items: end;
		gap: 12px;
		padding-top: 15px;
	}
	.tools label {
		text-align: right;
	}
	.tools audio {
		display: block;
		width: min(230px, 56vw);
		margin-top: 8px;
	}
	@media (max-width: 660px) {
		.albums {
			grid-template-columns: 1fr;
		}
		.explore-nav {
			gap: 20px;
			font-size: 14px;
		}
	}
</style>
