---
import CollectionLayout from "@/layouts/CollectionLayout.astro";
const skills = [
  {name:"PCB 焊接",text:"从立创 EDA 导出元件清单，核对位号并准备焊接。",link:"/posts/如何快速开始下一步焊接工作/"},
  {name:"原型机部件整理",text:"记录部件规格、配图和采购参考，整理成可复查的 BOM。",link:"/posts/planktoscope原型机部件清单/"},
];
---
<CollectionLayout title="技能" icon="material-symbols:construction" description="从公开笔记中整理的实践主题，点开可以查看对应的记录。">
 <div class="entries">{skills.map(s=><a class="entry" href={s.link}><h2>{s.name}</h2><p>{s.text}</p></a>)}</div>
</CollectionLayout>
