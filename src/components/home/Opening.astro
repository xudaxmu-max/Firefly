<section id="opening" aria-label="首页画廊" data-scene="0">
	<div class="frames">
		<img
			class="frame first"
			src="/gallery/blog-art/balcony.webp"
			width="1672"
			height="941"
			alt="阳台双人，人物相拥在石柱与玫瑰之间"
			fetchpriority="high"
		/>
		<img
			class="frame second"
			data-src="/gallery/blog-art/coronation.webp"
			width="1672"
			height="941"
			alt="宫廷加冕，红金色厅堂中的人物群像"
			aria-hidden="true"
		/>
	</div>
	<div class="identity">
		<h1>huazai<span>666</span></h1><p>工作手记、电子制作与个人项目</p>
	</div>
	<div class="hero-foot">
		<a href="#articles" class="read">阅读文章 <b aria-hidden="true">↓</b></a>
		<div class="playback" aria-label="油画切换">
			<span class="art-title">阳台双人</span><span class="counter">
				<i>01</i> / 02
			</span>
			<button type="button" class="change" aria-label="切换油画">
				→
			</button><button type="button" class="pause" aria-label="暂停轮播">
				<span aria-hidden="true">Ⅱ</span>
			</button>
		</div>
	</div>
</section>
<script>
	const root = document.querySelector<HTMLElement>("#opening")!;
	const second = root.querySelector<HTMLImageElement>(".second")!;
	const first = root.querySelector<HTMLImageElement>(".first")!;
	const motion = matchMedia("(prefers-reduced-motion: reduce)");
	const pause = root.querySelector<HTMLButtonElement>(".pause")!;
	let playing = !motion.matches,
		scene = 0,
		timer = 0,
		loading = false;
	function schedule() {
		clearTimeout(timer);
		if (playing && !document.hidden) timer = window.setTimeout(advance, 9500);
	}
	async function advance() {
		if (loading) return;
		loading = true;
		clearTimeout(timer);
		if (!second.src) second.src = second.dataset.src!;
		try {
			await second.decode();
		} catch {
			playing = false;
			sync();
			return;
		} finally {
			loading = false;
		}
		scene = 1 - scene;
		root.dataset.scene = String(scene);
		first.setAttribute("aria-hidden", String(!!scene));
		second.setAttribute("aria-hidden", String(!scene));
		root.querySelector(".art-title")!.textContent = scene
			? "宫廷加冕"
			: "阳台双人";
		root.querySelector(".counter i")!.textContent = scene ? "02" : "01";
		schedule();
	}
	function sync() {
		pause.setAttribute("aria-label", playing ? "暂停轮播" : "播放轮播");
		pause.firstElementChild!.textContent = playing ? "Ⅱ" : "▷";
		schedule();
	}
	root.querySelector(".change")!.addEventListener("click", advance);
	pause.addEventListener("click", () => {
		playing = !playing;
		sync();
	});
	motion.addEventListener("change", () => {
		playing = !motion.matches;
		sync();
	});
	document.addEventListener("visibilitychange", schedule);
	sync();
</script>
