---
import { navBarConfig, profileConfig } from "@/config";
import DiscoverySearch from "./DiscoverySearch.astro";
import { Icon } from "astro-icon/components";
const direct = [
	{ name: "主页", url: "/", icon: "material-symbols:home" },
	{ name: "文章", url: "/archive/", icon: "material-symbols:article" },
	...navBarConfig.links.filter((link) =>
		["番剧", "网址导航", "相册"].includes(link.name),
	),
];
const extra = navBarConfig.links
	.flatMap((link) => link.children || [])
	.filter((link) => !direct.some((item) => item.url === link.url));
const pathname = Astro.url.pathname;
const current = (href: string) =>
	pathname === href ||
	(href !== "/" && pathname.startsWith(href)) ||
	(href === "/archive/" && pathname.startsWith("/posts/"));
const activeMore = extra.some((link) => current(link.url));
---

<header class="home-nav">
	<a class="brand" href="/" aria-label={profileConfig.name + " 首页"}>
		<img src="/favicon/huazai666.png" alt="" width="25" height="25" />{
			profileConfig.name
		}
	</a>
	<nav aria-label="主导航">
		{
			direct.map((link) => (
				<a
					class="direct"
					href={link.url}
					aria-current={current(link.url) ? "location" : undefined}
				>
					<Icon name={link.icon!} />
					{link.name}
				</a>
			))
		}
		<details id="home-menu">
			<summary class:list={[{ selected: activeMore }]}>
				<Icon name="material-symbols:apps" /><span class="wide">更多</span><span
					class="small"
				>
					菜单
				</span><Icon name="material-symbols:keyboard-arrow-down" />
			</summary>
			<div class="menu-list">
				{
					direct.map((link) => (
						<a
							class="small"
							href={link.url}
							aria-current={current(link.url) ? "location" : undefined}
						>
							{link.name}
						</a>
					))
				}
				{
					extra.map((link) => (
						<a
							data-no-swup={link.url === "/work-log/" ? "" : undefined}
							href={link.url}
							aria-current={current(link.url) ? "location" : undefined}
						>
							{link.name}
						</a>
					))
				}
				<slot />
			</div>
		</details>
	</nav>
	<DiscoverySearch />
</header>
<script>
	const menu = document.querySelector<HTMLDetailsElement>("#home-menu")!;
	function syncLocation() {
		const pathname = location.pathname.replace(/\/?$/, "/");
		let more = false;
		for (const link of document.querySelectorAll<HTMLAnchorElement>(
			".home-nav nav a",
		)) {
			const active =
				link.origin === location.origin &&
				(link.pathname === pathname ||
					(link.pathname !== "/" && pathname.startsWith(link.pathname)) ||
					(link.pathname === "/archive/" && pathname.startsWith("/posts/")));
			if (active) link.setAttribute("aria-current", "location");
			else link.removeAttribute("aria-current");
			if (active && link.matches(".menu-list a:not(.small)")) more = true;
		}
		menu.querySelector("summary")?.classList.toggle("selected", more);
		menu.open = false;
	}
	document.addEventListener("swup:page:view", syncLocation);
	window.addEventListener("pageshow", syncLocation);
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && menu.open) {
			menu.open = false;
			menu.querySelector("summary")?.focus();
		}
	});
	document.addEventListener("click", (event) => {
		if (
			event.target instanceof Element &&
			(!menu.contains(event.target) || event.target.closest("a"))
		)
			menu.open = false;
	});
</script>
<style>
	.home-nav {
		--nav-height: 44px;
		--nav-surface: #0c0c0df7;
		--nav-shadow: 0 3px 16px #0003;
		position: fixed;
		z-index: 8;
		top: 12px;
		left: clamp(18px, 4.3vw, 88px);
		right: clamp(18px, 4.3vw, 88px);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: start;
		pointer-events: none;
		color: #f6f4ef;
	}
	.home-nav > a,
	nav {
		pointer-events: auto;
		border-radius: 999px;
		background: var(--nav-surface);
		box-shadow: var(--nav-shadow);
	}
	.brand,
	nav,
	.direct,
	summary {
		display: flex;
		align-items: center;
	}
	.brand {
		height: var(--nav-height);
		gap: 9px;
		padding: 0 16px;
		justify-self: start;
		font-weight: 650;
	}
	.home-nav a {
		text-decoration: none;
	}
	.home-nav :focus-visible {
		outline: 2px solid #d9b878;
		outline-offset: 2px;
	}
	.brand img {
		border-radius: 50%;
	}
	nav {
		padding: 4px 6px;
		gap: 2px;
		font-size: 15px;
		font-weight: 620;
	}
	.direct,
	summary {
		border-radius: 999px;
		padding: 0 13px;
		height: calc(var(--nav-height) - 8px);
		gap: 6px;
	}
	.direct svg,
	summary svg {
		width: 16px;
		height: 16px;
	}
	.direct[aria-current],
	summary.selected,
	.menu-list a[aria-current] {
		background: #faf9f5;
		color: #121211;
	}
	.direct:not([aria-current]):hover,
	summary:hover,
	.brand:hover {
		background: #323232;
		color: white;
	}
	details {
		position: relative;
	}
	summary {
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.menu-list {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		min-width: 174px;
		max-height: 70svh;
		overflow: auto;
		border-radius: 16px;
		padding: 8px;
		background: #111112;
		box-shadow: 0 5px 24px #0005;
	}
	.menu-list a {
		display: block;
		padding: 9px 13px;
		border-radius: 10px;
	}
	.menu-list a:hover,
	.menu-list a:focus-visible {
		background: #353533;
	}
	.small,
	.menu-list .small {
		display: none;
	}
	@media (max-width: 1280px) {
		:global(.home-nav:has(discovery-search[expanded])) nav {
			visibility: hidden;
			opacity: 0;
		}
	}
	@media (max-width: 560px) {
		:global(.home-nav:has(discovery-search[expanded])) .brand {
			visibility: hidden;
			opacity: 0;
		}
	}
	@media (max-width: 940px) {
		.home-nav {
			grid-template-columns: 1fr auto 1fr;
		}
		.direct,
		.wide {
			display: none;
		}
		.small,
		.menu-list .small {
			display: block;
		}
		.menu-list {
			right: 50%;
			transform: translateX(50%);
		}
		.brand {
			padding: 0 12px;
		}
	}
	@media (max-width: 390px) {
		.home-nav {
			left: 12px;
			right: 12px;
		}
		.brand {
			font-size: 14px;
		}
	}
	@media (max-width: 480px) {
		.home-nav {
			grid-template-columns: auto 1fr auto;
		}
		nav {
			justify-self: center;
		}
	}
</style>
