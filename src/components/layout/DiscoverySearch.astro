<discovery-search>
	<form action="/search/" method="get" role="search" aria-label="站内搜索">
		<div class="field">
			<a
				class="trigger"
				href="/search/"
				data-no-swup
				aria-label="展开搜索"
				title="搜索文章（⌘K / Ctrl K）"
			>
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<circle cx="10.5" cy="10.5" r="6.75"></circle><path
						d="m16 16 4.75 4.75"
					>
					</path>
				</svg>
			</a>
			<input
				name="q"
				type="search"
				placeholder="搜索文章"
				aria-label="搜索文章"
				enterkeyhint="search"
				autocomplete="off"
				required
				disabled
			/>
		</div>

	</form>
</discovery-search>
<script>
	class DiscoverySearch extends HTMLElement {
		connectedCallback() {
			const form = this.querySelector("form")!;
			const trigger = this.querySelector("a")!;
			const input = this.querySelector("input")!;
			const controller = new AbortController();
			this.cleanup = () => controller.abort();
			const options = { signal: controller.signal };
			const setExpanded = (expanded: boolean, restoreFocus = false) => {
				this.toggleAttribute("expanded", expanded);
				trigger.setAttribute("aria-expanded", String(expanded));
				trigger.setAttribute("aria-label", expanded ? "提交搜索" : "展开搜索");
				input.disabled = !expanded;
				if (expanded) {
					const menu = this.closest("header")?.querySelector("details");
					if (menu) menu.open = false;
					input.focus({ preventScroll: true });
				} else {
					input.value = "";
					if (restoreFocus) trigger.focus({ preventScroll: true });
				}
			};
			setExpanded(false);
			trigger.addEventListener(
				"click",
				(event) => {
					if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
						return;
					event.preventDefault();
					if (this.hasAttribute("expanded")) form.requestSubmit();
					else setExpanded(true);
				},
				options,
			);
			form.addEventListener(
				"submit",
				(event) => {
					input.value = input.value.trim();
					if (!input.value) {
						event.preventDefault();
						input.focus();
					}
				},
				options,
			);
			document.addEventListener(
				"keydown",
				(event) => {
					if (event.isComposing) return;
					if (
						(event.ctrlKey || event.metaKey) &&
						event.key.toLowerCase() === "k"
					) {
						event.preventDefault();
						setExpanded(true);
					} else if (event.key === "Escape" && this.hasAttribute("expanded")) {
						event.preventDefault();
						setExpanded(false, true);
					}
				},
				options,
			);
			document.addEventListener(
				"pointerdown",
				(event) => {
					if (
						this.hasAttribute("expanded") &&
						!event.composedPath().includes(this)
					)
						setExpanded(false);
				},
				options,
			);
			document.addEventListener(
				"swup:page:view",
				() => setExpanded(false),
				options,
			);
			window.addEventListener("pageshow", () => setExpanded(false), options);
		}
		private cleanup?: () => void;
		disconnectedCallback() {
			this.cleanup?.();
		}
	}
	if (!customElements.get("discovery-search"))
		customElements.define("discovery-search", DiscoverySearch);
</script>
<style>
	discovery-search {
		--closed-width: 68px;
		--spring: cubic-bezier(0.22, 1.2, 0.32, 1);
		justify-self: end;
		position: relative;
		height: var(--nav-height);
		width: var(--closed-width);
		pointer-events: auto;
	}
	form {
		position: absolute;
		right: 0;
		top: 0;
		margin: 0;
	}
	.field {
		display: flex;
		align-items: center;
		height: var(--nav-height);
		width: var(--closed-width);
		overflow: hidden;
		border-radius: 999px;
		background: var(--nav-surface);
		color: inherit;
		box-shadow: var(--nav-shadow);
		transition: width 0.56s var(--spring);
	}
	discovery-search[expanded] .field {
		width: min(300px, calc(100vw - 36px));
	}
	.trigger {
		display: grid;
		place-items: center;
		cursor: pointer;
		width: var(--closed-width);
		height: 100%;
		flex: none;
		color: inherit;
	}
	discovery-search[expanded] .trigger {
		width: var(--nav-height);
	}
	svg {
		width: 19px;
		height: 19px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	input {
		background: transparent;
		color: inherit;
		border: 0;
		outline: 0;
		min-width: 0;
		width: 100%;
		padding: 0 14px 0 0;
		font-family: inherit;
		font-size: 16px;
		font-weight: 500;
		line-height: 1.3;
		opacity: 0;
		transform-origin: left;
		transform: scale(0.65, 0.85);
		filter: blur(4px);
		transition:
			opacity 0.15s,
			transform 0.2s,
			filter 0.15s;
	}
	input::placeholder {
		color: #c7c6c4;
	}
	input::-webkit-search-cancel-button {
		display: none;
	}
	discovery-search[expanded] input {
		opacity: 1;
		transform: none;
		filter: none;
	}
	.field:has(.trigger:focus-visible) {
		outline: 2px solid #d9b878;
		outline-offset: 2px;
	}
	@media (prefers-reduced-motion: reduce) {
		.field, input {
			transition: none;
		}
	}
</style>
