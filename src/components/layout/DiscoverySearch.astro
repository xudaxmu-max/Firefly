<discovery-search>
	<form action="/search/" method="get" role="search" aria-label="站内搜索">
		<div class="field">
			<a
				class="trigger"
				href="/search/"
				data-no-swup
				aria-label="展开搜索"
				title="搜索文章（⌘K / Ctrl K）"
			>
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<circle cx="10.5" cy="10.5" r="6.75"></circle><path
						d="m16 16 4.75 4.75"
					>
					</path>
				</svg>
			</a>
			<input
				name="q"
				type="search"
				placeholder="搜索文章"
				aria-label="搜索文章"
				enterkeyhint="search"
				autocomplete="off"
				required
				disabled
			/>
		</div>
		<button class="dismiss" type="button" aria-label="收起搜索" disabled>
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<path d="m6 6 12 12M18 6 6 18"></path>
			</svg>
		</button>
	</form>
</discovery-search>
<script>
	class DiscoverySearch extends HTMLElement {
		connectedCallback() {
			const form = this.querySelector("form")!;
			const trigger = this.querySelector("a")!;
			const input = this.querySelector("input")!;
			const dismiss = this.querySelector("button")!;
			const controller = new AbortController();
			this.cleanup = () => controller.abort();
			const options = { signal: controller.signal };
			const setExpanded = (expanded: boolean, restoreFocus = false) => {
				this.toggleAttribute("expanded", expanded);
				trigger.setAttribute("aria-expanded", String(expanded));
				trigger.setAttribute("aria-label", expanded ? "提交搜索" : "展开搜索");
				input.disabled = dismiss.disabled = !expanded;
				if (expanded) {
					const menu = this.closest("header")?.querySelector("details");
					if (menu) menu.open = false;
					input.focus({ preventScroll: true });
				} else {
					input.value = "";
					if (restoreFocus) trigger.focus({ preventScroll: true });
				}
			};
			setExpanded(false);
			trigger.addEventListener(
				"click",
				(event) => {
					if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
						return;
					event.preventDefault();
					if (this.hasAttribute("expanded")) form.requestSubmit();
					else setExpanded(true);
				},
				options,
			);
			form.addEventListener(
				"submit",
				(event) => {
					input.value = input.value.trim();
					if (!input.value) {
						event.preventDefault();
						input.focus();
					}
				},
				options,
			);
			dismiss.addEventListener(
				"click",
				() => setExpanded(false, true),
				options,
			);
			document.addEventListener(
				"keydown",
				(event) => {
					if (event.isComposing) return;
					if (
						(event.ctrlKey || event.metaKey) &&
						event.key.toLowerCase() === "k"
					) {
						event.preventDefault();
						setExpanded(true);
					} else if (event.key === "Escape" && this.hasAttribute("expanded")) {
						event.preventDefault();
						setExpanded(false, true);
					}
				},
				options,
			);
			document.addEventListener(
				"pointerdown",
				(event) => {
					if (
						this.hasAttribute("expanded") &&
						!event.composedPath().includes(this)
					)
						setExpanded(false);
				},
				options,
			);
			document.addEventListener(
				"swup:page:view",
				() => setExpanded(false),
				options,
			);
			window.addEventListener("pageshow", () => setExpanded(false), options);
		}
		private cleanup?: () => void;
		disconnectedCallback() {
			this.cleanup?.();
		}
	}
	if (!customElements.get("discovery-search"))
		customElements.define("discovery-search", DiscoverySearch);
</script>
<style>
	discovery-search {
		--size: 56px;
		--paper: #fff;
		--ink: #171717;
		--stroke: #efefef;
		--placeholder: #707070;
		--spring: cubic-bezier(0.22, 1.2, 0.32, 1);
		justify-self: end;
		position: relative;
		height: var(--size);
		width: var(--size);
		pointer-events: auto;
	}
	:global(html.dark) discovery-search {
		--paper: #171717;
		--ink: #f4f4f4;
		--stroke: #333;
		--placeholder: #aaa;
	}
	form {
		position: absolute;
		right: 0;
		top: 0;
		display: flex;
		align-items: center;
		gap: 0;
		margin: 0;
		transition: gap 0.4s var(--spring);
	}
	.field,
	.dismiss {
		display: flex;
		align-items: center;
		height: var(--size);
		border: 1px solid var(--stroke);
		border-radius: 28px;
		background: var(--paper);
		color: var(--ink);
		box-shadow: 0 2px 9px #0002;
	}
	.field {
		width: var(--size);
		overflow: hidden;
		transition: width 0.56s var(--spring);
	}
	discovery-search[expanded] form {
		gap: 8px;
	}
	discovery-search[expanded] .field {
		width: min(320px, calc(100vw - var(--size) - 48px));
	}
	.trigger,
	.dismiss {
		display: grid;
		place-items: center;
		cursor: pointer;
	}
	.trigger {
		width: calc(var(--size) - 2px);
		height: 100%;
		flex: none;
		color: inherit;
	}
	svg {
		width: 19px;
		height: 19px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	input {
		background: transparent;
		color: var(--ink);
		border: 0;
		outline: 0;
		min-width: 0;
		width: 100%;
		padding: 0 14px 0 0;
		font-family: inherit;
		font-size: 16px;
		font-weight: 500;
		line-height: 1.3;
		opacity: 0;
		transform-origin: left;
		transform: scale(0.65, 0.85);
		filter: blur(4px);
		transition:
			opacity 0.15s,
			transform 0.2s,
			filter 0.15s;
	}
	input::placeholder {
		color: var(--placeholder);
	}
	input::-webkit-search-cancel-button {
		display: none;
	}
	discovery-search[expanded] input {
		opacity: 1;
		transform: none;
		filter: none;
	}
	.dismiss {
		width: 0;
		min-width: 0;
		overflow: hidden;
		opacity: 0;
		border-width: 0;
		padding: 0;
		transform: scale(0.65);
		pointer-events: none;
		transition:
			width 0.48s var(--spring),
			transform 0.45s var(--spring),
			opacity 0.18s;
	}
	discovery-search[expanded] .dismiss {
		width: var(--size);
		opacity: 1;
		transform: none;
		border-width: 1px;
		pointer-events: auto;
	}
	.field:focus-within,
	.dismiss:focus-visible {
		outline: 2px solid #aa854e;
		outline-offset: 2px;
	}
	@media (max-width: 640px) {
		discovery-search {
			--size: 48px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		form,
		.field,
		input,
		.dismiss {
			transition: none;
		}
	}
</style>
